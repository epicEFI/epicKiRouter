(pcb drc-main.dsn

  (parser
    (string_quote ")
    (space_in_quoted_tokens on)
  )
  (resolution um 1)
  (unit um)
  (structure
    (layer F.Cu (type signal))
    (layer B.Cu (type signal))
    (boundary (rect pcb 0 0 250000 140000))
    (keepout (rect F.Cu 40000 40000 50000 50000))
    (rule (width 250) (clearance 2000))
  )
  (placement
    (component CMP1
      (place CMP1 10000 10000 front 0)
    )
  )
  (library
    (padstack PAD_R
      (shape (rect F.Cu -1000 -1000 1000 1000))
    )
    (padstack PAD_V
      (shape (circle F.Cu 600 0 0))
      (shape (circle B.Cu 600 0 0))
    )
    (image CMP1
      (pin PAD_R P1 0 0)
      (pin PAD_R P2 20000 0)
      (pin PAD_R P3 0 20000)
      (pin PAD_R P4 60000 60000)
      (pin PAD_R P7 170000 35000)
      (pin PAD_R P8 90000 60000)
      (pin PAD_R P9 110000 60000)
      (pin PAD_R P10 240000 60000)
      (pin PAD_R P11 230000 60000)
      (pin PAD_R P13 238999 10000)
    )
  )
  (network
    (net NQ (pins CMP1-P1) (pins CMP1-P2) (pins CMP1-P3) (pins CMP1-P4))
    (net NC)
    (net N3 (pins CMP1-P8) (pins CMP1-P9))
    (net NV (pins CMP1-P7))
    (net NZ)
    (net NX)
    (net NY)
    (net NP (pins CMP1-P10) (pins CMP1-P11))
    (net NP2 (pins CMP1-P13))
    (net NA)
    (net NB)
  )
  (wiring
    (wire (rect F.Cu 60000 5000 70000 15000) (net NC))
    (wire (rect F.Cu 130000 65000 140000 75000) (net NC))
    (wire (rect F.Cu 130000 65000 140000 75000) (net N3))
    (wire (path F.Cu 250  200000 20000  210000 20000) (net NV))
    (via PAD_V 200000 20000 (net NV))
    (wire (path B.Cu 250  210000 20000  220000 20000) (net NV))
    (via PAD_V 210000 20000 (net NV))
    (wire (path F.Cu 250  220000 20000  230000 20000) (net NZ))
    (via PAD_V 230000 20000 (net NZ))
    (wire (path F.Cu 250  180000 90000  200000 90000) (net NX))
    (wire (path F.Cu 250  190000 90000  210000 90000) (net NY))
    (wire (path F.Cu 250  230000 110000  240000 110000) (net NA))
    (wire (path F.Cu 250  230000 110600  240000 110600) (net NB))
  )
)
