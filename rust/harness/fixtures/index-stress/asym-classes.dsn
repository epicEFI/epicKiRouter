(pcb asym-classes.dsn
  (parser
    (string_quote ")
    (space_in_quoted_tokens on)
  )
  (resolution um 1)
  (unit um)
  (structure
    (layer F.Cu (type signal))
    (layer B.Cu (type signal))
    (boundary (rect pcb 0 0 100000 60000))
    (rule (width 250) (clearance 14))
  )
  (placement)
  (library)
  (network
    (net NA)
    (net NB)
    (net NC)
    (class CB NB
      (rule (width 250) (clearance 55))
    )
    (class CC NC
      (rule (width 250) (clearance 99))
    )
  )
  (wiring
    (wire (path F.Cu 250  10000 10000 30000 10000) (net NA))
    (wire (path F.Cu 250  10000 20000 30000 20000) (net NB))
    (wire (path F.Cu 250  10000 30000 30000 30000) (net NC))
  )
)
