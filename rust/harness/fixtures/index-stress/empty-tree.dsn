(pcb empty-tree.dsn
  (parser
    (string_quote ")
    (space_in_quoted_tokens on)
  )
  (resolution um 1)
  (unit um)
  (structure
    (layer F.Cu (type signal))
    (layer B.Cu (type signal))
    (boundary (rect pcb 0 0 100000 60000))
    (rule (width 250) (clearance 14))
  )
  (placement)
  (library)
  (network
    (net SN)
  )
  (wiring
    (wire (path F.Cu 250  5000 3000 15000 3000) (net SN))
  )
)
