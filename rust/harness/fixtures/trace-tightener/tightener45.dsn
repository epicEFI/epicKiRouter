(PCB tightener45.dsn
  (parser
    (string_quote ")
    (space_in_quoted_tokens on)
    (case_sensitive off)
  )
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu
      (type signal)
      (property
        (index 0)
      )
    )
    (layer B.Cu
      (type signal)
      (property
        (index 1)
      )
    )
    (boundary (rect pcb 0 0 120000 60000))
    (snap_angle fortyfive_degree)
    (rule (width 200) (clearance 250))
  )
  (placement
    (component "CA"
      (place "PA_COMP" 2000 2000 Front 0.000000)
    )
  )
  (library
    (image "CA"
      (pin "PADT" "PA" 0 0)
    )
    (padstack "PADT"
      (shape (polygon F.Cu 0  2000 2000 -2000 2000 -2000 -2000 2000 -2000  2000 2000))
      (attach off)
    )
  )
  (network
    (net "N1")
    (class kicad_default "N1"
      (rule
        (clearance 250)
      )
    )
  )
  (wiring
    (wire (path F.Cu 200  10000 10000 20000 10000 30000 20000 40000 20000 50000 30000 60000 30000) (net N1))
  )
)
