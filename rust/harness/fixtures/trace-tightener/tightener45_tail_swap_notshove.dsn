(PCB tightener45_tail_swap_notshove.dsn
  (parser
    (string_quote ")
    (space_in_quoted_tokens on)
    (case_sensitive off)
  )
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu
      (type signal)
      (property
        (index 0)
      )
    )
    (layer B.Cu
      (type signal)
      (property
        (index 1)
      )
    )
    (boundary (rect pcb 0 0 120000 60000))
    (snap_angle fortyfive_degree)
    (rule (width 200) (clearance 250))
  )
  (placement
    (component "CT"
      (place "CT_COMP" 5000 5000 Front 0.000000)
    )
  )
  (library
    (image "CT"
      (pin "PADR" "PT" 0 0)
    )
    (padstack "PADR"
      (shape (rect F.Cu -500 -500 500 500))
      (attach off)
    )
  )
  (network
    (net "N1" (pins "CT_COMP"-"PT"))
    (class kicad_default "N1"
      (rule
        (clearance 250)
      )
    )
  )
  (wiring
    (wire (path F.Cu 200  5000 5000 15000 5000) (net N1) (type protect))
    (wire (path F.Cu 200  15000 5000 12000 8000 12000 18000 2000 18000 2000 5000 4650 5000) (net N1))
  )
)
