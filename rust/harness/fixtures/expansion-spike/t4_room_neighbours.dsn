(PCB "t4_room_neighbours.dsn"
  (parser
    (string_quote ")
    (space_in_quoted_tokens on)
    (case_sensitive off)
  )
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu
      (type signal)
      (property
        (index 0)
      )
    )
    (layer B.Cu
      (type signal)
      (property
        (index 1)
      )
    )
    (boundary
      (path pcb 0  0 0  100000 0  100000 60000  0 60000  0 0)
    )
    (keepout ""
      (polygon F.Cu 0  20000 20000 40000 20000 40000 40000 20000 40000  20000 20000)
    )
    (keepout ""
      (polygon F.Cu 0  60000 20000 80000 20000 80000 40000 60000 40000  60000 20000)
    )
    (keepout ""
      (polygon F.Cu 0  44000 48000 56000 48000 56000 54000 44000 54000  44000 48000)
    )
    (rule
      (clearance 250)
    )
  )
  (placement
    (component "CA"
      (place "KA" 10000 52000 Front 0.000000)
    )
    (component "CB"
      (place "KB" 90000 8000 Front 0.000000)
    )
  )
  (library
    (image "CA"
      (pin "PADA" "PA" 0 0)
    )
    (image "CB"
      (pin "PADB" "PB" 0 0)
    )
    (padstack "PADA"
      (shape (polygon F.Cu 0  2000 2000 -2000 2000 -2000 -2000 2000 -2000  2000 2000))
      (attach off)
    )
    (padstack "PADB"
      (shape (polygon F.Cu 0  2000 2000 -2000 2000 -2000 -2000 2000 -2000  2000 2000))
      (attach off)
    )
  )
  (network
    (net "NET_A"
      (pins "KA"-"PA")
    )
    (net "NET_B"
      (pins "KB"-"PB")
    )
    (class kicad_default "NET_A"
      (rule
        (clearance 250)
      )
    )
    (class t4_slow "NET_B"
      (rule
        (clearance 1000)
      )
    )
  )
)
